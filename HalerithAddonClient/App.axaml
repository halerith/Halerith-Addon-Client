<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HalerithAddonClient.App"
             Name="Halerith Addon Client"
             RequestedThemeVariant="Dark">
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Halerith Addon Client..." Click="AboutApplicationMenuItem_OnClick" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Application.Styles>
</Application>
