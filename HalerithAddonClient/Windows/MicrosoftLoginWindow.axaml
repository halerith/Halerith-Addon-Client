<Window x:Class="HalerithAddonClient.Windows.MicrosoftLoginWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in with Microsoft"
        Width="420" Height="320"
        MinWidth="380" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False">

    <Grid RowDefinitions="*" Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Heading -->
            <TextBlock x:Name="_headingText"
                       Text="Sign in with Microsoft"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <!-- User code display -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="6"
                    Padding="20,10"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8">
                <TextBlock x:Name="_codeText"
                           Text="--------"
                           FontSize="28" FontWeight="Bold"
                           FontFamily="Consolas, Courier New, monospace"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           LetterSpacing="4"/>
            </Border>

            <!-- Copy code button -->
            <Button x:Name="_copyButton"
                    Content="Copy Code"
                    HorizontalAlignment="Center"
                    MinWidth="121" Height="31"
                    Click="CopyButton_Click"
                    Margin="0,0,0,16"/>

            <!-- Instruction -->
            <TextBlock x:Name="_instructionText"
                       Text="To sign in, open a browser and go to:"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- URL -->
            <TextBlock x:Name="_urlText"
                       Text="https://microsoft.com/link"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBlueBrush}"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       TextDecorations="Underline"
                       PointerPressed="UrlText_PointerPressed"
                       Margin="0,0,0,12"/>

            <!-- Status / progress -->
            <TextBlock x:Name="_statusText"
                       Text="Waiting for you to enter the code…"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>

            <!-- Error text (hidden by default) -->
            <TextBlock x:Name="_errorText"
                       Text=""
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       Margin="0,8,0,0"/>

        </StackPanel>
    </Grid>
</Window>
